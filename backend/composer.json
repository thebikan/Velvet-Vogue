{
  "name": "velvet-vogue/backend",
  "description": "Velvet Vogue modular PHP backend foundation",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2 <8.5",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "vlucas/phpdotenv": "^5.6",
    "php-di/php-di": "^7.0",
    "monolog/monolog": "^3.0",
    "symfony/http-foundation": "^7.4",
    "symfony/routing": "^7.4",
    "symfony/validator": "^7.4",
    "symfony/security-csrf": "^7.4",
    "symfony/cache": "^7.4",
    "symfony/rate-limiter": "^7.4",
    "symfony/lock": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "VelvetVogue\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VelvetVogue\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --exclude-group database --exclude-group redis",
    "test:database": "phpunit --group database",
    "analyse": "phpstan analyse --memory-limit=512M",
    "style": "phpcs",
    "style:fix": "phpcbf",
    "check": [
      "@lint",
      "@test",
      "@analyse",
      "@style"
    ],
    "lint": "@php bin/lint.php",
    "test:redis": "phpunit --group redis",
    "db:schema": "@php bin/export-schema.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "platform": {
      "php": "8.2.0"
    }
  }
}
