# Copy to .env for local only; real process variables take priority.
# APP_ENV: local, testing, staging, production. No debug output is exposed over HTTP.
APP_ENV=local
APP_NAME="Velvet Vogue"
# Dedicated least-privilege credentials; set before calling readiness.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=velvet_vogue
DB_USERNAME=velvet_vogue
DB_PASSWORD=
DB_TIMEOUT=3
# Independent database/account. Must end in _test. Never point at production.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_DATABASE=velvet_vogue_test
TEST_DB_USERNAME=velvet_vogue_test
TEST_DB_PASSWORD=
# JSON request bytes; mirror this ceiling at the reverse proxy.
MAX_BODY_BYTES=1048576
RATE_LIMIT=120
# file is local-only; staging/production require redis for shared counters/locks.
CACHE_DRIVER=file
REDIS_URL=
# auto means stderr in staging/production, rotating files locally (14 days).
LOG_TARGET=auto
LOG_LEVEL=info
# Secure cookies required for deployed TLS environments.
SESSION_SECURE=true
