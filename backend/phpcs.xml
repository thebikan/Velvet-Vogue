<?xml version="1.0"?>
<ruleset name="Velvet Vogue">
  <arg name="extensions" value="php"/>
  <rule ref="PSR12"/>
  <file>bin</file><file>src</file><file>bootstrap</file><file>config</file><file>routes</file><file>public</file><file>tests</file><file>workers</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <rule ref="Generic.Files.LineLength"><properties><property name="lineLimit" value="180"/><property name="absoluteLineLimit" value="0"/></properties></rule>
</ruleset>
